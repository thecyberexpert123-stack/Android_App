{
  "extensions": [
    {
      "id": "androde.kotlin",
      "name": "kotlin",
      "displayName": "Kotlin",
      "description": "Kotlin language support with syntax highlighting, snippets, and IntelliSense",
      "version": "1.0.0",
      "publisher": "Androde",
      "categories": ["Programming Languages"],
      "tags": ["kotlin", "jvm", "android"],
      "isBuiltin": true,
      "contributes": {
        "languages": [
          {
            "id": "kotlin",
            "extensions": [".kt", ".kts"],
            "aliases": ["Kotlin", "kotlin"],
            "configuration": "kotlin-language-configuration.json"
          }
        ],
        "grammars": [
          {
            "language": "kotlin",
            "scopeName": "source.kotlin",
            "path": "textmate/grammars/kotlin.tmLanguage.json"
          }
        ],
        "snippets": [
          {
            "language": "kotlin",
            "path": "snippets/kotlin.json"
          }
        ]
      }
    },
