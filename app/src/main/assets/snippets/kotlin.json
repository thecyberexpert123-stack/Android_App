    "description": "Val declaration"
  },
  "Kotlin var": {
    "prefix": "var",
    "body": [
      "var ${1:name} = ${0}"
    ],
    "description": "Var declaration"
  },
  "Kotlin companion": {
    "prefix": "companion",
    "body": [
      "companion object {",
      "    ${0}",
      "}"
    ],
    "description": "Companion object"
  }
