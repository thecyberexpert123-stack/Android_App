{
  "Function": {
    "prefix": "function",
    "body": ["function ${1:name}(${2:params})", "    ${3}", "end"],
    "description": "Lua function"
  },
  "Local Function": {
    "prefix": "local function",
    "body": ["local function ${1:name}(${2:params})", "    ${3}", "end"],
    "description": "Local function"
  },
  "If": {
    "prefix": "if",
    "body": ["if ${1:condition} then", "    ${2}", "end"],
    "description": "If statement"
  },
  "For": {
    "prefix": "for",
    "body": ["for ${1:i} = ${2:1}, ${3:10} do", "    ${4}", "end"],
    "description": "For loop"
  },
  "For In": {
    "prefix": "forin",
    "body": ["for ${1:k}, ${2:v} in ${3:pairs}(${4:table}) do", "    ${5}", "end"],
    "description": "For in loop"
  },
  "Print": {
    "prefix": "print",
    "body": ["print(${1:message})"],
    "description": "Print"
  }
}
