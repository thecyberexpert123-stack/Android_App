{
  "JS function": {
    "prefix": "fun",
    "body": [
      "function ${1:name}(${2:params}) {",
      "    ${0}",
      "}"
    ],
    "description": "Function declaration"
  },
  "JS arrow": {
    "prefix": "arrow",
    "body": [
      "const ${1:name} = (${2:params}) => {",
      "    ${0}",
      "}"
    ],
    "description": "Arrow function"
  },
  "JS class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "    constructor(${2:params}) {",
      "        ${0}",
      "    }",
      "}"
    ],
    "description": "Class"
  },
  "JS if": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "    ${0}",
      "}"
    ],
    "description": "If statement"
  },
  "JS for": {
    "prefix": "for",
    "body": [
      "for (let ${1:i} = 0; ${1:i} < ${2:length}; ${1:i}++) {",
      "    ${0}",
      "}"
    ],
    "description": "For loop"
  },
  "JS log": {
    "prefix": "log",
    "body": [
      "console.log(${0});"
    ],
    "description": "Console log"
  },
  "JS import": {
    "prefix": "imp",
    "body": [
      "import ${1:module} from '${0:package}';"
    ],
    "description": "Import"
  }
}
