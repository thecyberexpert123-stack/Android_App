{
  "name": "OpenCL",
  "scopeName": "source.opencl",
  "fileTypes": ["opencl"],
  "patterns": [
    {"include": "#comment"},
    {"include": "#string"},
    {"include": "#keyword"},
    {"include": "#opencl_keyword"},
    {"include": "#type"},
    {"include": "#function"},
    {"include": "#variable"},
    {"include": "#numeric"},
    {"include": "#preprocessor"}
  ],
  "repository": {
    "comment": {
      "patterns": [
        {"name": "comment.line.double-slash.opencl", "match": "//.*$"},
        {"name": "comment.block.opencl", "begin": "/\\*", "end": "\\*/"}
      ]
    },
    "string": {
      "patterns": [
        {"name": "string.quoted.double.opencl", "begin": "\"", "end": "\"", "patterns": [{"name": "constant.character.escape.opencl", "match": "\\\\."}]}
      ]
    },
    "keyword": {
      "patterns": [
        {"name": "keyword.control.opencl", "match": "\\b(if|else|for|while|do|switch|case|default|break|continue|return|struct|union|enum|typedef|const|static|extern|inline|volatile|kernel|attribute|uniform|varying)\\b"}
      ]
    },
    "opencl_keyword": {
      "patterns": [
        {"name": "keyword.other.opencl", "match": "\\b(__kernel|__global|__local|__constant|__private|__read_only|__write_only|__read_write|__generic|kernel|global|local|constant|private|read_only|write_only|get_global_id|get_local_id|get_group_id|get_global_size|get_local_size|get_num_groups|barrier|mem_fence|read_mem_fence|write_mem_fence|async_work_group_copy|wait_group_events|prefetch)\\b"}
      ]
    },
    "type": {
      "patterns": [
        {"name": "storage.type.opencl", "match": "\\b(void|bool|char|short|int|long|float|double|size_t|ptrdiff_t|intptr_t|uintptr_t|char2|char3|char4|char8|char16|uchar2|uchar3|uchar4|short2|short3|short4|ushort2|ushort3|ushort4|int2|int3|int4|uint2|uint3|uint4|long2|long3|long4|ulong2|ulong3|ulong4|float2|float3|float4|double2|double3|double4|image2d_t|image3d_t|sampler_t|event_t)\\b"}
      ]
    },
    "function": {
      "patterns": [
        {"name": "entity.name.function.opencl", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\s*(?=\\()"}
      ]
    },
    "variable": {
      "patterns": [
        {"name": "variable.other.opencl", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"}
      ]
    },
    "numeric": {
      "patterns": [
        {"name": "constant.numeric.opencl", "match": "\\b\\d+\\.\\d*f?\\b|\\b\\d+\\b|\\b0x[0-9a-fA-F]+\\b"}
      ]
    },
    "preprocessor": {
      "patterns": [
        {"name": "keyword.control.directive.opencl", "match": "^\\s*#\\s*(include|define|ifdef|ifndef|if|else|elif|endif|pragma)\\b"}
      ]
    }
  }
}
