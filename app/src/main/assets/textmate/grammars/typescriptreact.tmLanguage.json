{
  "name": "TypeScript React",
  "scopeName": "source.tsx",
  "fileTypes": ["tsx"],
  "patterns": [
    {"include": "#comment"},
    {"include": "#string"},
    {"include": "#jsx"},
    {"include": "#keyword"},
    {"include": "#type"},
    {"include": "#function"},
    {"include": "#class"},
    {"include": "#numeric"}
  ],
  "repository": {
    "comment": {
      "patterns": [
        {"name": "comment.line.double-slash.ts", "match": "//.*$"},
        {"name": "comment.block.ts", "begin": "/\\*", "end": "\\*/"}
      ]
    },
    "string": {
      "patterns": [
        {"name": "string.quoted.double.ts", "begin": "\"", "end": "\"", "patterns": [{"name": "constant.character.escape.ts", "match": "\\\\."}]},
        {"name": "string.quoted.single.ts", "begin": "'", "end": "'", "patterns": [{"name": "constant.character.escape.ts", "match": "\\\\."}]},
        {"name": "string.template.ts", "begin": "`", "end": "`", "patterns": [{"name": "constant.character.escape.ts", "match": "\\\\."}, {"name": "meta.embedded.expression.ts", "begin": "\\$\\{", "end": "\\}"}]}
      ]
    },
    "jsx": {
      "patterns": [
        {"name": "meta.tag.tsx", "begin": "(<)([A-Za-z][A-Za-z0-9]*)(?=[\\s>/])", "end": "(>)", "beginCaptures": {"1": {"name": "punctuation.definition.tag.tsx"}, "2": {"name": "entity.name.tag.tsx"}}, "endCaptures": {"1": {"name": "punctuation.definition.tag.tsx"}}, "patterns": [{"include": "#jsx-attribute"}]},
        {"name": "meta.tag.tsx", "begin": "(</)([A-Za-z][A-Za-z0-9]*)(>)", "captures": {"1": {"name": "punctuation.definition.tag.tsx"}, "2": {"name": "entity.name.tag.tsx"}, "3": {"name": "punctuation.definition.tag.tsx"}}}
      ]
    },
    "jsx-attribute": {
      "patterns": [
        {"name": "entity.other.attribute-name.tsx", "match": "[A-Za-z][A-Za-z0-9\\-]*"},
        {"name": "string.quoted.double.tsx", "begin": "\"", "end": "\""},
        {"name": "string.quoted.single.tsx", "begin": "'", "end": "'"},
        {"name": "meta.embedded.expression.tsx", "begin": "\\{", "end": "\\}"}
      ]
    },
    "keyword": {
      "name": "keyword.control.ts",
      "match": "\\b(break|case|catch|class|const|continue|debugger|default|delete|do|else|export|extends|false|finally|for|from|function|if|import|in|instanceof|let|new|null|return|super|switch|this|throw|true|try|typeof|var|void|while|with|yield|async|await|static|get|set|of|interface|type|implements|private|public|protected|readonly|abstract|namespace|module|declare|enum|keyof|infer|is|as|out|override)\\b"
    },
    "type": {
      "name": "storage.type.ts",
      "match": "\\b(string|number|boolean|any|void|never|unknown|object|String|Number|Boolean|Array|Promise|Observable|void)\\b"
    },
    "function": {"name": "entity.name.function.ts", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\s*(?=\\()"},
    "class": {"name": "entity.name.type.class.ts", "match": "\\b[A-Z][A-Za-z0-9_]*\\b"},
    "numeric": {"name": "constant.numeric.ts", "match": "\\b\\d+(\\.\\d+)?\\b"}
  }
}
