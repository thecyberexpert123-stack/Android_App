{
  "name": "ActionScript",
  "scopeName": "source.actionscript",
  "fileTypes": ["as"],
  "patterns": [
    {"include": "#comment"},
    {"include": "#string"},
    {"include": "#keyword"},
    {"include": "#class"},
    {"include": "#function"},
    {"include": "#number"}
  ],
  "repository": {
    "comment": {"patterns": [{"name": "comment.line.double-slash.as", "match": "//.*$"}, {"name": "comment.block.as", "begin": "/\\*", "end": "\\*/"}]},
    "string": {"patterns": [{"name": "string.quoted.double.as", "begin": "\"", "end": "\"", "patterns": [{"name": "constant.character.escape.as", "match": "\\\\."}]}, {"name": "string.quoted.single.as", "begin": "'", "end": "'", "patterns": [{"name": "constant.character.escape.as", "match": "\\\\."}]}]},
    "keyword": {"name": "keyword.control.as", "match": "\\b(package|import|class|interface|extends|implements|public|private|protected|internal|static|final|override|function|var|const|if|else|for|while|do|switch|case|default|break|continue|return|try|catch|finally|throw|new|this|super|instanceof|is|as|in|typeof|void|true|false|null|undefined|get|set|namespace|use|include)\\b"},
    "class": {"name": "entity.name.type.class.as", "match": "\\bclass\\s+([A-Za-z_][A-Za-z0-9_]*)\\b", "captures": {"1": {"name": "entity.name.type.class.as"}}},
    "function": {"name": "entity.name.function.as", "match": "\\bfunction\\s+([A-Za-z_][A-Za-z0-9_]*)\\b", "captures": {"1": {"name": "entity.name.function.as"}}},
    "number": {"name": "constant.numeric.as", "match": "\\b\\d+(\\.\\d+)?\\b"}
  }
}
