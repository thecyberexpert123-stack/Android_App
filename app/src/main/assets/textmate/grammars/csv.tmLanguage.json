{
  "name": "CSV",
  "scopeName": "text.csv",
  "fileTypes": ["csv"],
  "patterns": [
    { "name": "string.quoted.double.csv", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.csv", "match": "\"\"" }] },
    { "name": "punctuation.separator.comma.csv", "match": "," },
    { "name": "constant.numeric.csv", "match": "\\b\\d+(\\.\\d+)?\\b" }
  ]
}
