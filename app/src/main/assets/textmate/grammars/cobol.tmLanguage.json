{
  "name": "COBOL",
  "scopeName": "source.cobol",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#divisions" },
    { "include": "#numeric" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.cobol", "match": "^.{6}\\*.*$" },
        { "name": "comment.line.cobol", "match": "\\*>.*$" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.double.cobol", "begin": "\"", "end": "\"" },
        { "name": "string.quoted.single.cobol", "begin": "'", "end": "'" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.cobol", "match": "(?i)\\b(IF|ELSE|END-IF|PERFORM|UNTIL|VARYING|FROM|BY|MOVE|TO|ADD|SUBTRACT|MULTIPLY|DIVIDE|COMPUTE|DISPLAY|ACCEPT|STOP|RUN|GOBACK|EXIT|CALL|USING|RETURNING|EVALUATE|WHEN|END-EVALUATE|INSPECT|STRING|UNSTRING|SEARCH|SET|INITIALIZE)\\b" },
        { "name": "storage.type.cobol", "match": "(?i)\\b(PIC|PICTURE|VALUE|OCCURS|REDEFINES|USAGE|COMP|COMP-3|BINARY|PACKED-DECIMAL|INDEXED|ORGANIZATION|ACCESS|RECORD|KEY|FILE|FD|WORKING-STORAGE|LINKAGE|LOCAL-STORAGE)\\b" }
      ]
    },
    "divisions": {
      "patterns": [
        { "name": "entity.name.section.cobol", "match": "(?i)\\b(IDENTIFICATION|ENVIRONMENT|DATA|PROCEDURE)\\s+DIVISION\\b" },
        { "name": "entity.name.section.cobol", "match": "(?i)\\b(PROGRAM-ID|AUTHOR|DATE-WRITTEN|CONFIGURATION|INPUT-OUTPUT|FILE|WORKING-STORAGE|LINKAGE)\\s+SECTION\\b" }
      ]
    },
    "numeric": {
      "patterns": [{ "name": "constant.numeric.cobol", "match": "\\b\\d+(\\.\\d+)?\\b" }]
    }
  }
}
