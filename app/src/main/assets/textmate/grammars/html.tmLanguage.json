{
  "name": "HTML",
  "scopeName": "text.html.basic",
  "fileTypes": ["html", "htm"],
  "patterns": [
    { "name": "comment.block.html", "begin": "<!--", "end": "-->" },
    { "name": "meta.tag.html", "begin": "(<)([a-zA-Z0-9]+)", "end": "(>)", "captures": { "1": { "name": "punctuation.definition.tag.html" }, "2": { "name": "entity.name.tag.html" } }, "patterns": [{ "name": "entity.other.attribute-name.html", "match": "\\b[a-zA-Z_:][a-zA-Z0-9_:\\-]*\\b" }, { "name": "string.quoted.double.html", "begin": "\"", "end": "\"" }, { "name": "string.quoted.single.html", "begin": "'", "end": "'" }] },
    { "name": "meta.tag.html", "begin": "(</)([a-zA-Z0-9]+)(>)", "captures": { "1": { "name": "punctuation.definition.tag.html" }, "2": { "name": "entity.name.tag.html" }, "3": { "name": "punctuation.definition.tag.html" } } },
    { "name": "keyword.other.doctype.html", "match": "<!DOCTYPE[^>]*>" },
    { "name": "constant.character.entity.html", "match": "&[a-zA-Z0-9#]+;" }
  ]
}
