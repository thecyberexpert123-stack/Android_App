{
  "name": "Nim",
  "scopeName": "source.nim",
  "fileTypes": ["nim", "nims", "nimble"],
  "patterns": [
    {"include": "#comment"},
    {"include": "#string"},
    {"include": "#keyword"},
    {"include": "#type"},
    {"include": "#function"},
    {"include": "#number"}
  ],
  "repository": {
    "comment": {"patterns": [{"name": "comment.line.number-sign.nim", "match": "#.*$"}, {"name": "comment.block.nim", "begin": "#\\[", "end": "\\]#"}]},
    "string": {"patterns": [{"name": "string.quoted.double.nim", "begin": "\"", "end": "\"", "patterns": [{"name": "constant.character.escape.nim", "match": "\\\\."}]}, {"name": "string.quoted.triple.nim", "begin": "\"\"\"", "end": "\"\"\""}]},
    "keyword": {"name": "keyword.control.nim", "match": "\\b(proc|func|method|iterator|template|macro|if|elif|else|when|case|of|for|while|break|continue|return|yield|try|except|finally|raise|import|from|include|export|let|var|const|type|using|block|do|defer|discard|distinct|enum|object|tuple|concept|mixin|static|defer|asm|bind|cast|addr|unsafeAddr|typeof|new|ref|ptr|shared|guarded)\\b"},
    "type": {"name": "support.type.nim", "match": "\\b(int|int8|int16|int32|int64|uint|uint8|uint16|uint32|uint64|float|float32|float64|bool|string|char|seq|array|Table|HashSet|set|range|auto|void)\\b"},
    "function": {"name": "entity.name.function.nim", "match": "\\bproc\\s+([A-Za-z_][A-Za-z0-9_]*)\\b", "captures": {"1": {"name": "entity.name.function.nim"}}},
    "number": {"name": "constant.numeric.nim", "match": "\\b\\d+(\\.\\d+)?\\b"}
  }
}
