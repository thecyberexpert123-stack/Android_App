{
  "name": "JavaScript",
  "scopeName": "source.js",
  "fileTypes": ["js", "jsx", "mjs", "cjs"],
  "patterns": [
    { "name": "comment.line.double-slash.js", "match": "//.*$" },
    { "name": "comment.block.js", "begin": "/\\*", "end": "\\*/" },
    { "name": "string.quoted.double.js", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.js", "match": "\\\\." }] },
    { "name": "string.quoted.single.js", "begin": "'", "end": "'", "patterns": [{ "name": "constant.character.escape.js", "match": "\\\\." }] },
    { "name": "string.template.js", "begin": "`", "end": "`", "patterns": [{ "name": "constant.character.escape.js", "match": "\\\\." }, { "name": "variable.other.js", "begin": "\\$\\{", "end": "}" }] },
    { "name": "keyword.control.js", "match": "\\b(break|case|catch|continue|debugger|default|delete|do|else|finally|for|function|if|in|instanceof|new|return|switch|this|throw|try|typeof|var|void|while|with|let|const|class|extends|export|import|super|yield|async|await|static|get|set|of|from|as)\\b" },
    { "name": "keyword.operator.js", "match": "\\b(null|true|false|undefined|NaN|Infinity)\\b" },
    { "name": "entity.name.function.js", "match": "\\b(function)\\s+([a-zA-Z_$][a-zA-Z0-9_$]*)", "captures": { "1": { "name": "keyword.control.js" }, "2": { "name": "entity.name.function.js" } } },
    { "name": "entity.name.type.class.js", "match": "\\b(class)\\s+([A-Z][a-zA-Z0-9_$]*)", "captures": { "1": { "name": "keyword.control.js" }, "2": { "name": "entity.name.type.class.js" } } },
    { "name": "constant.numeric.js", "match": "\\b\\d+(\\.\\d+)?\\b" },
    { "name": "support.function.js", "match": "\\b(console\\.(log|warn|error|info)|parseInt|parseFloat|isNaN|isFinite|setTimeout|setInterval|clearTimeout|clearInterval|require|module\\.exports)\\b" }
  ]
}
