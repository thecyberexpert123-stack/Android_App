{
  "name": "C++",
  "scopeName": "source.cpp",
  "fileTypes": ["cpp", "cc", "cxx", "hpp", "h", "c"],
  "patterns": [
    { "name": "comment.line.double-slash.cpp", "match": "//.*$" },
    { "name": "comment.block.cpp", "begin": "/\\*", "end": "\\*/" },
    { "name": "string.quoted.double.cpp", "begin": "\"", "end": "\"" },
    { "name": "string.quoted.single.cpp", "begin": "'", "end": "'" },
    { "name": "keyword.control.cpp", "match": "\\b(alignas|alignof|asm|auto|bool|break|case|catch|char|char16_t|char32_t|class|const|constexpr|const_cast|continue|decltype|default|delete|do|double|dynamic_cast|else|enum|explicit|export|extern|false|float|for|friend|goto|if|inline|int|long|mutable|namespace|new|noexcept|nullptr|operator|private|protected|public|register|reinterpret_cast|return|short|signed|sizeof|static|static_assert|static_cast|struct|switch|template|this|thread_local|throw|true|try|typedef|typeid|typename|union|unsigned|using|virtual|void|volatile|wchar_t|while)\\b" },
    { "name": "keyword.directive.cpp", "match": "^\\s*#\\s*(include|define|ifdef|ifndef|if|else|elif|endif|pragma|undef|error|warning|line)\\b" },
    { "name": "entity.name.function.cpp", "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(" },
    { "name": "constant.numeric.cpp", "match": "\\b\\d+(\\.\\d+)?\\b" }
  ]
}
