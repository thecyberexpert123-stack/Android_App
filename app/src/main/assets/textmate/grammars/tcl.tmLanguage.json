{
  "name": "Tcl",
  "scopeName": "source.tcl",
  "fileTypes": ["tcl"],
  "patterns": [
    {"include": "#comment"},
    {"include": "#string"},
    {"include": "#keyword"},
    {"include": "#variable"},
    {"include": "#function"},
    {"include": "#number"}
  ],
  "repository": {
    "comment": {"name": "comment.line.number-sign.tcl", "match": "#.*$"},
    "string": {"name": "string.quoted.double.tcl", "begin": "\"", "end": "\"", "patterns": [{"name": "variable.other.tcl", "match": "\\$[A-Za-z_][A-Za-z0-9_]*"}]},
    "keyword": {"name": "keyword.control.tcl", "match": "\\b(if|then|else|elseif|for|foreach|while|break|continue|proc|return|set|global|upvar|variable|namespace|package|require|source|eval|expr|incr|append|lappend|switch|case|default|catch|error|throw|try|finally|on|format|puts|gets|open|close|read|write|file|list|dict|array|string|regexp|regsub)\\b"},
    "variable": {"name": "variable.other.tcl", "match": "\\$[A-Za-z_][A-Za-z0-9_]*|\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}"},
    "function": {"name": "entity.name.function.tcl", "match": "\\bproc\\s+([A-Za-z_][A-Za-z0-9_]*)\\b", "captures": {"1": {"name": "entity.name.function.tcl"}}},
    "number": {"name": "constant.numeric.tcl", "match": "\\b\\d+(\\.\\d+)?\\b"}
  }
}
