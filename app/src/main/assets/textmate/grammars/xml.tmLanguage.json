{
  "name": "XML",
  "scopeName": "text.xml",
  "fileTypes": ["xml", "xsl", "xsd", "svg", "plist"],
  "patterns": [
    { "name": "comment.block.xml", "begin": "<!--", "end": "-->" },
    { "name": "meta.tag.xml", "begin": "(<\\??)([a-zA-Z0-9:_\\-]+)", "end": "(\\??>)", "captures": { "1": { "name": "punctuation.definition.tag.xml" }, "2": { "name": "entity.name.tag.xml" } }, "patterns": [{ "name": "entity.other.attribute-name.xml", "match": "[a-zA-Z_:][a-zA-Z0-9_:\\-]*" }, { "name": "string.quoted.double.xml", "begin": "\"", "end": "\"" }, { "name": "string.quoted.single.xml", "begin": "'", "end": "'" }] },
    { "name": "meta.tag.xml", "begin": "(</)([a-zA-Z0-9:_\\-]+)(>)", "captures": { "1": { "name": "punctuation.definition.tag.xml" }, "2": { "name": "entity.name.tag.xml" }, "3": { "name": "punctuation.definition.tag.xml" } } },
    { "name": "keyword.other.doctype.xml", "match": "<!DOCTYPE[^>]*>" },
    { "name": "constant.character.entity.xml", "match": "&[a-zA-Z0-9#]+;" },
    { "name": "entity.other.attribute-name.xml", "match": "[a-zA-Z_:][a-zA-Z0-9_:\\-]*" }
  ]
}
