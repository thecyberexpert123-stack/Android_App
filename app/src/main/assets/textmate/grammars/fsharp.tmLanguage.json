{
  "scopeName": "source.fsharp",
  "name": "F#",
  "fileTypes": ["fs", "fsi", "fsx", "fsscript"],
  "patterns": [
    {"include": "#comment"},
    {"include": "#string"},
    {"include": "#keyword"},
    {"include": "#function"},
    {"include": "#type"},
    {"include": "#numeric"}
  ],
  "repository": {
    "comment": {"patterns": [
      {"name": "comment.line.double-slash.fsharp", "match": "//.*$"},
      {"name": "comment.block.fsharp", "begin": "\\(\\*", "end": "\\*\\)"}
    ]},
    "string": {"patterns": [
      {"name": "string.quoted.double.fsharp", "begin": "\"", "end": "\"", "patterns": [{"name": "constant.character.escape.fsharp", "match": "\\\\."}]},
      {"name": "string.quoted.triple.fsharp", "begin": "\"\"\"", "end": "\"\"\""},
      {"name": "string.quoted.single.fsharp", "begin": "'", "end": "'", "patterns": [{"name": "constant.character.escape.fsharp", "match": "\\\\."}]}
    ]},
    "keyword": {"name": "keyword.control.fsharp", "match": "\\b(let|let!|use|use!|do|do!|if|then|else|elif|match|with|when|for|while|return|yield|yield!|try|with|finally|open|module|namespace|type|let|member|override|abstract|default|static|mutable|rec|and|or|not|in|as|of|fun|function|if|then|else|match|with|when|for|do|while|to|downto|exception|external|global|include|inherit|interface|internal|private|public|sealed|struct|begin|end|done|downto|to)\\b"},
    "function": {"name": "entity.name.function.fsharp", "match": "\\blet\\s+(?:rec\\s+)?([A-Za-z_][A-Za-z0-9_']*)"},
    "type": {"name": "entity.name.type.fsharp", "match": "\\btype\\s+([A-Za-z_][A-Za-z0-9_']*)"},
    "numeric": {"name": "constant.numeric.fsharp", "match": "\\b\\d+(?:\\.\\d+)?\\b"}
  }
}
