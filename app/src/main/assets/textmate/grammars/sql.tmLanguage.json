{
  "name": "SQL",
  "scopeName": "source.sql",
  "fileTypes": ["sql"],
  "patterns": [
    { "name": "comment.line.double-dash.sql", "match": "--.*$" },
    { "name": "comment.block.sql", "begin": "/\\*", "end": "\\*/" },
    { "name": "string.quoted.single.sql", "begin": "'", "end": "'", "patterns": [{ "name": "constant.character.escape.sql", "match": "''" }] },
    { "name": "string.quoted.double.sql", "begin": "\"", "end": "\"" },
    { "name": "keyword.other.sql", "match": "\\b(SELECT|FROM|WHERE|INSERT|UPDATE|DELETE|CREATE|ALTER|DROP|TABLE|INDEX|VIEW|DATABASE|TRIGGER|PROCEDURE|FUNCTION|JOIN|INNER|LEFT|RIGHT|OUTER|FULL|ON|AS|AND|OR|NOT|NULL|TRUE|FALSE|ORDER|BY|GROUP|HAVING|LIMIT|OFFSET|UNION|ALL|DISTINCT|INTO|VALUES|SET|PRIMARY|KEY|FOREIGN|REFERENCES|CONSTRAINT|CHECK|DEFAULT|AUTO_INCREMENT|UNIQUE|NOT|EXISTS|BETWEEN|LIKE|IN|IS|CASE|WHEN|THEN|ELSE|END|BEGIN|COMMIT|ROLLBACK|TRANSACTION|GRANT|REVOKE)\\b" },
    { "name": "keyword.other.data-type.sql", "match": "\\b(INT|INTEGER|BIGINT|SMALLINT|TINYINT|DECIMAL|NUMERIC|FLOAT|DOUBLE|REAL|CHAR|VARCHAR|TEXT|BLOB|DATE|TIME|DATETIME|TIMESTAMP|BOOLEAN|BOOL|JSON|UUID)\\b" },
    { "name": "constant.numeric.sql", "match": "\\b\\d+(\\.\\d+)?\\b" },
    { "name": "support.function.sql", "match": "\\b(COUNT|SUM|AVG|MIN|MAX|UPPER|LOWER|LENGTH|SUBSTRING|CONCAT|COALESCE|NOW|CURDATE|CURTIME|YEAR|MONTH|DAY)\\b" }
  ]
}
