{
  "name": "TypeScript",
  "scopeName": "source.ts",
  "fileTypes": ["ts", "tsx"],
  "patterns": [
    { "name": "comment.line.double-slash.ts", "match": "//.*$" },
    { "name": "comment.block.ts", "begin": "/\\*", "end": "\\*/" },
    { "name": "string.quoted.double.ts", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.ts", "match": "\\\\." }] },
    { "name": "string.quoted.single.ts", "begin": "'", "end": "'", "patterns": [{ "name": "constant.character.escape.ts", "match": "\\\\." }] },
    { "name": "string.template.ts", "begin": "`", "end": "`" },
    { "name": "keyword.control.ts", "match": "\\b(break|case|catch|continue|debugger|default|delete|do|else|finally|for|function|if|in|instanceof|new|return|switch|this|throw|try|typeof|var|void|while|with|let|const|class|extends|export|import|super|yield|async|await|static|get|set|of|from|as|interface|type|implements|private|public|protected|readonly|abstract|namespace|module|declare|enum|keyof|infer)\\b" },
    { "name": "keyword.operator.ts", "match": "\\b(null|true|false|undefined)\\b" },
    { "name": "entity.name.function.ts", "match": "\\b(function)\\s+([a-zA-Z_$][a-zA-Z0-9_$]*)" },
    { "name": "entity.name.type.class.ts", "match": "\\b(class|interface|type|enum)\\s+([A-Z][a-zA-Z0-9_$]*)" },
    { "name": "constant.numeric.ts", "match": "\\b\\d+(\\.\\d+)?\\b" }
  ]
}
