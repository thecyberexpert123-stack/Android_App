{
  "name": "TOML",
  "scopeName": "source.toml",
  "fileTypes": ["toml"],
  "patterns": [
    { "name": "comment.line.number-sign.toml", "match": "#.*$" },
    { "name": "entity.name.section.toml", "match": "^\\s*\\[.*\\]\\s*$" },
    { "name": "entity.name.section.toml", "match": "^\\s*\\[\\[.*\\]\\]\\s*$" },
    { "name": "keyword.other.key.toml", "match": "^\\s*[A-Za-z0-9_\\-\\.]+\\s*(?=\\=)" },
    { "name": "punctuation.separator.key-value.toml", "match": "=" },
    { "name": "string.quoted.double.toml", "begin": "\"\"\"", "end": "\"\"\"", "patterns": [{ "name": "constant.character.escape.toml", "match": "\\\\." }] },
    { "name": "string.quoted.double.toml", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.toml", "match": "\\\\." }] },
    { "name": "string.quoted.single.toml", "begin": "'", "end": "'" },
    { "name": "constant.numeric.toml", "match": "\\b\\d+(\\.\\d+)?\\b" },
    { "name": "constant.language.boolean.toml", "match": "\\b(true|false)\\b" },
    { "name": "constant.language.toml", "match": "\\b(inf|nan)\\b" }
  ]
}
