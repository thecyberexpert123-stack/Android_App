{
  "name": "CMake",
  "scopeName": "source.cmake",
  "fileTypes": ["cmake", "CMakeLists.txt"],
  "patterns": [
    { "name": "comment.line.number-sign.cmake", "match": "#.*$" },
    { "name": "keyword.control.cmake", "match": "\\b(if|else|elseif|endif|foreach|endforeach|while|endwhile|function|endfunction|macro|endmacro|return|break|continue)\\b" },
    { "name": "support.function.cmake", "match": "\\b(project|cmake_minimum_required|add_executable|add_library|add_subdirectory|include_directories|target_include_directories|target_link_libraries|find_package|find_library|find_path|find_program|include|set|option|message|configure_file|install|enable_testing|add_test|set_property|get_property|list|file|string|math|execute_process|add_custom_command|add_custom_target)\\b" },
    { "name": "string.quoted.double.cmake", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.cmake", "match": "\\\\." }] },
    { "name": "variable.other.cmake", "match": "\\$\\{[A-Za-z0-9_]+\\}|\\$<[^>]+>|\\$\\{[A-Za-z0-9_]+\\}" },
    { "name": "constant.numeric.cmake", "match": "\\b\\d+(\\.\\d+)?\\b" },
    { "name": "constant.language.cmake", "match": "\\b(ON|OFF|TRUE|FALSE|YES|NO)\\b" }
  ]
}
