{
  "name": "D",
  "scopeName": "source.d",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#numeric" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.d", "match": "//.*$" },
        { "name": "comment.block.d", "begin": "/\\*", "end": "\\*/" },
        { "name": "comment.block.documentation.d", "begin": "/\\*\\*", "end": "\\*/" },
        { "name": "comment.block.d", "begin": "/\\+", "end": "\\+/" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.double.d", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.d", "match": "\\\\." }] },
        { "name": "string.quoted.single.d", "begin": "'", "end": "'", "patterns": [{ "name": "constant.character.escape.d", "match": "\\\\." }] },
        { "name": "string.quoted.double.d", "begin": "`", "end": "`" },
        { "name": "string.quoted.double.d", "begin": "q\"\\[", "end": "\\]\"" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.d", "match": "\\b(if|else|for|foreach|foreach_reverse|while|do|switch|case|default|break|continue|return|try|catch|finally|throw|import|module|package|class|struct|union|interface|enum|template|mixin|alias|with|scope|synchronized|version|debug|static|final|abstract|override|public|private|protected|extern|ref|out|inout|lazy|auto|const|immutable|shared|__gshared|nothrow|pure|@safe|@trusted|@system|@nogc|@property|@disable)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.d", "match": "\\b(void|bool|byte|ubyte|short|ushort|int|uint|long|ulong|cent|ucent|float|double|real|ifloat|idouble|ireal|cfloat|cdouble|creal|char|wchar|dchar|string|wstring|dstring|size_t|ptrdiff_t)\\b" }
      ]
    },
    "functions": {
      "patterns": [
        { "name": "entity.name.function.d", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\s*(?=\\()" }
      ]
    },
    "numeric": {
      "patterns": [{ "name": "constant.numeric.d", "match": "\\b\\d[\\d_]*\\.?[\\d_]*([eE][+-]?\\d+)?[fFLuU]*\\b" }]
    }
  }
}
