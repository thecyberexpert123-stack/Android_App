{
  "name": "Prisma",
  "scopeName": "source.prisma",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#attributes" },
    { "include": "#numeric" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.prisma", "match": "//.*$" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.prisma", "match": "\\b(datasource|generator|model|enum|type|view)\\b" },
        { "name": "keyword.other.prisma", "match": "\\b(provider|url|shadowDatabaseUrl|previewFeatures|binaryTargets|output|engineType)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.prisma", "match": "\\b(String|Boolean|Int|BigInt|Float|Decimal|DateTime|Json|Bytes|Unsupported)\\b" },
        { "name": "entity.name.type.prisma", "match": "\\b[A-Z][a-zA-Z0-9_]*\\b" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.double.prisma", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.prisma", "match": "\\\\." }] }
      ]
    },
    "attributes": {
      "patterns": [
        { "name": "entity.name.function.attribute.prisma", "match": "@(@)?[a-zA-Z_][a-zA-Z0-9_]*" },
        { "name": "keyword.operator.prisma", "match": "\\?|\\[\\]" }
      ]
    },
    "numeric": {
      "patterns": [{ "name": "constant.numeric.prisma", "match": "\\b\\d+\\b" }]
    }
  }
}
