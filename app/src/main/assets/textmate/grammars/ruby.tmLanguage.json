{
  "name": "Ruby",
  "scopeName": "source.ruby",
  "fileTypes": ["rb", "ruby", "rake", "gemspec"],
  "patterns": [
    { "name": "comment.line.number-sign.ruby", "match": "#.*$" },
    { "name": "comment.block.ruby", "begin": "=begin", "end": "=end" },
    { "name": "string.quoted.double.ruby", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.ruby", "match": "\\\\." }, { "name": "variable.other.ruby", "begin": "#\\{", "end": "}" }] },
    { "name": "string.quoted.single.ruby", "begin": "'", "end": "'" },
    { "name": "keyword.control.ruby", "match": "\\b(BEGIN|END|alias|and|begin|break|case|class|def|defined\\?|do|else|elsif|end|ensure|false|for|if|in|module|next|nil|not|or|redo|rescue|retry|return|self|super|then|true|undef|unless|until|when|while|yield|__FILE__|__LINE__|__ENCODING__)\\b" },
    { "name": "entity.name.type.class.ruby", "match": "\\b(class|module)\\s+([A-Z][a-zA-Z0-9_]*)" },
    { "name": "entity.name.function.ruby", "match": "\\b(def)\\s+([a-zA-Z_][a-zA-Z0-9_]*[\\?\\!]?)" },
    { "name": "constant.numeric.ruby", "match": "\\b\\d+(\\.\\d+)?\\b" },
    { "name": "variable.other.ruby", "match": "@@[a-zA-Z_][a-zA-Z0-9_]*|@[a-zA-Z_][a-zA-Z0-9_]*|\\$[a-zA-Z_][a-zA-Z0-9_]*" }
  ]
}
