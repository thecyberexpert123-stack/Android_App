{
  "name": "ShaderLab",
  "scopeName": "source.shaderlab",
  "fileTypes": ["shader", "cginc", "hlslinc"],
  "patterns": [
    {"include": "#comment"},
    {"include": "#string"},
    {"include": "#keyword"},
    {"include": "#type"},
    {"include": "#function"},
    {"include": "#number"}
  ],
  "repository": {
    "comment": {"patterns": [{"name": "comment.line.double-slash.shaderlab", "match": "//.*$"}, {"name": "comment.block.shaderlab", "begin": "/\\*", "end": "\\*/"}]},
    "string": {"name": "string.quoted.double.shaderlab", "begin": "\"", "end": "\""},
    "keyword": {"name": "keyword.control.shaderlab", "match": "\\b(Shader|Properties|SubShader|Pass|Tags|LOD|Cull|ZWrite|ZTest|Blend|ColorMask|CGPROGRAM|ENDCG|HLSLPROGRAM|ENDHLSL|Fallback|CustomEditor|Category|GrabPass|UsePass|if|else|for|while|return|break|continue|struct|fixed|half|float|int|bool|sampler2D|samplerCUBE)\\b"},
    "type": {"name": "support.type.shaderlab", "match": "\\b(float|float2|float3|float4|half|half2|half3|half4|fixed|fixed2|fixed3|fixed4|int|int2|int3|int4|bool|sampler2D|samplerCUBE|Texture2D)\\b"},
    "function": {"name": "entity.name.function.shaderlab", "match": "\\b([a-zA-Z_]\\w*)\\s*(?=\\()"},
    "number": {"name": "constant.numeric.shaderlab", "match": "\\b\\d+(\\.\\d+)?\\b"}
  }
}
