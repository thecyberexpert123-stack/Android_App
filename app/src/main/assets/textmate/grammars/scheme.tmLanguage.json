{
  "name": "Scheme",
  "scopeName": "source.scheme",
  "fileTypes": ["scm", "ss", "sch", "sld"],
  "patterns": [
    {"include": "#comment"},
    {"include": "#string"},
    {"include": "#keyword"},
    {"include": "#function"},
    {"include": "#number"}
  ],
  "repository": {
    "comment": {"patterns": [{"name": "comment.line.semicolon.scheme", "match": ";.*$"}, {"name": "comment.block.scheme", "begin": "#\\|", "end": "\\|#"}]},
    "string": {"name": "string.quoted.double.scheme", "begin": "\"", "end": "\"", "patterns": [{"name": "constant.character.escape.scheme", "match": "\\\\."}]},
    "keyword": {"name": "keyword.control.scheme", "match": "\\b(define|define-syntax|define-macro|lambda|if|cond|case|else|let|let\\*|letrec|let-values|begin|set!|quote|quasiquote|unquote|unquote-splicing|and|or|not|when|unless|do|delay|force|parameterize|guard|with-exception-handler|import|export|library|include|include-ci|cond-expand)\\b"},
    "function": {"name": "entity.name.function.scheme", "match": "\\(define\\s+\\(?([A-Za-z_\\-\\?\\!][A-Za-z0-9_\\-\\?\\!]*)\", "captures": {"1": {"name": "entity.name.function.scheme"}}},
    "number": {"name": "constant.numeric.scheme", "match": "\\b\\d+(\\.\\d+)?\\b"}
  }
}
