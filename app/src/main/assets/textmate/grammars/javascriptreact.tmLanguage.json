{
  "name": "JavaScript React",
  "scopeName": "source.js.jsx",
  "fileTypes": ["jsx"],
  "patterns": [
    {"include": "#comment"},
    {"include": "#string"},
    {"include": "#jsx"},
    {"include": "#keyword"},
    {"include": "#function"},
    {"include": "#class"},
    {"include": "#numeric"}
  ],
  "repository": {
    "comment": {
      "patterns": [
        {"name": "comment.line.double-slash.js", "match": "//.*$"},
        {"name": "comment.block.js", "begin": "/\\*", "end": "\\*/"}
      ]
    },
    "string": {
      "patterns": [
        {"name": "string.quoted.double.js", "begin": "\"", "end": "\"", "patterns": [{"name": "constant.character.escape.js", "match": "\\\\."}]},
        {"name": "string.quoted.single.js", "begin": "'", "end": "'", "patterns": [{"name": "constant.character.escape.js", "match": "\\\\."}]},
        {"name": "string.template.js", "begin": "`", "end": "`", "patterns": [{"name": "constant.character.escape.js", "match": "\\\\."}, {"name": "meta.embedded.expression.js", "begin": "\\$\\{", "end": "\\}"}]}
      ]
    },
    "jsx": {
      "patterns": [
        {"name": "meta.tag.jsx", "begin": "(<)([A-Za-z][A-Za-z0-9]*)(?=[\\s>/])", "end": "(>)", "beginCaptures": {"1": {"name": "punctuation.definition.tag.jsx"}, "2": {"name": "entity.name.tag.jsx"}}, "endCaptures": {"1": {"name": "punctuation.definition.tag.jsx"}}, "patterns": [{"include": "#jsx-attribute"}]},
        {"name": "meta.tag.jsx", "begin": "(</)([A-Za-z][A-Za-z0-9]*)(>)", "captures": {"1": {"name": "punctuation.definition.tag.jsx"}, "2": {"name": "entity.name.tag.jsx"}, "3": {"name": "punctuation.definition.tag.jsx"}}}
      ]
    },
    "jsx-attribute": {
      "patterns": [
        {"name": "entity.other.attribute-name.jsx", "match": "[A-Za-z][A-Za-z0-9\\-]*"},
        {"name": "string.quoted.double.jsx", "begin": "\"", "end": "\""},
        {"name": "string.quoted.single.jsx", "begin": "'", "end": "'"},
        {"name": "meta.embedded.expression.jsx", "begin": "\\{", "end": "\\}"}
      ]
    },
    "keyword": {
      "name": "keyword.control.js",
      "match": "\\b(break|case|catch|class|const|continue|debugger|default|delete|do|else|export|extends|false|finally|for|from|function|if|import|in|instanceof|let|new|null|return|super|switch|this|throw|true|try|typeof|var|void|while|with|yield|async|await|static|get|set|of)\\b"
    },
    "function": {"name": "entity.name.function.js", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\s*(?=\\()"},
    "class": {"name": "entity.name.type.class.js", "match": "\\b[A-Z][A-Za-z0-9_]*\\b"},
    "numeric": {"name": "constant.numeric.js", "match": "\\b\\d+(\\.\\d+)?\\b"}
  }
}
